# ==============================================================================
# ResearchMind - Environment Configuration Template
# ==============================================================================
# Copy this file to '.env' and fill in your actual credentials.
# Note: NEVER commit the actual '.env' file to source control.
# ==============================================================================

# OpenAI API Key (Required)
# Used by ChatOpenAI (gpt-4o-mini) for agent reasoning, report synthesis, and critique.
# Obtain your key at: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# Tavily Search API Key (Required)
# Used by TavilyClient for autonomous real-time web search and content gathering.
# Obtain your key at: https://tavily.com
TAVILY_API_KEY=your_tavily_api_key_here
